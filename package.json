{
  "name": "rafisa-developer-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-route-metadata.mjs",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "test:build": "node scripts/check-build.mjs",
    "verify": "npm test && npm run lint && npm run build && npm run test:build && git diff --check",
    "check:content": "node scripts/check-content.mjs",
    "prebuild": "npm run check:content",
    "test:preview": "node scripts/check-preview.mjs",
    "test:browser": "node scripts/check-browser.mjs"
  },
  "dependencies": {
    "i18next": "^27.1.3",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
